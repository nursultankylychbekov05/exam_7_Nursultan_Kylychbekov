@model LibraryApp.Models.Book

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4" style="max-width: 700px;">
    <h2>Детальная информация о книге</h2>
    <hr />

    <div class="card mb-3 p-4 shadow-sm">
        <div class="row g-0">
            <div class="col-md-4 text-center">
                <img src="@(string.IsNullOrEmpty(Model.CoverImagePath) ? "https://via.placeholder.com/150x200?text=No+Cover" : Model.CoverImagePath)" 
                     class="img-fluid rounded" style="max-height: 250px;" alt="Обложка">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h3 class="card-title">@Model.Title</h3>
                    <p class="card-text"><strong>Автор:</strong> @Model.Author</p>
                    <p class="card-text"><strong>Категория:</strong> <span class="badge bg-info text-dark">@(Model.Category?.Name ?? "Без категории")</span></p>
                    <p class="card-text"><strong>Год выпуска:</strong> @(Model.PublishYear?.ToString() ?? "Не указан")</p>
                    <p class="card-text">
                        <strong>Статус:</strong> 
                        <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-danger")">
                            @(Model.IsAvailable ? "В наличии" : "Выдана")
                        </span>
                    </p>
                    <p class="card-text"><strong>Дата добавления:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</p>
                </div>
            </div>
        </div>
        
        <div class="mt-3">
            <h5>Описание:</h5>
            <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "Описание отсутствует." : Model.Description)</p>
        </div>
    </div>

    <div>
        <a asp-action="Index" class="btn btn-secondary">На главную</a>
    </div>
</div>