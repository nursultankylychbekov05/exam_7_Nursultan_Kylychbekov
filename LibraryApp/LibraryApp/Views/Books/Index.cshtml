@model IEnumerable<LibraryApp.Models.Book>

@{
    ViewData["Title"] = "Главная - Библиотека";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container mt-4">
    <h2>Библиотека</h2>
    <hr />
    
    <ul class="nav nav-pills mb-4">
        <li class="nav-item"><a class="nav-link active" asp-controller="Books" asp-action="Index">Главная</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="BorrowedBooks">Выданные книги</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Books" asp-action="Create">Добавить книгу</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Категории</a></li>
        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Account">Личный кабинет</a></li>
    </ul>
    
    <form method="get" asp-action="Index" class="row g-3 mb-4 p-3 bg-light rounded shadow-sm">
        <div class="col-md-3">
            <input type="text" name="searchString" class="form-control" value="@ViewBag.CurrentSearch" placeholder="Поиск по названию или автору..." />
        </div>

        <div class="col-md-2">
            <select name="categoryId" class="form-select">
                <option value="">Все категории</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories)
                    {
                        if (ViewBag.CurrentCategory == cat.Id)
                        {
                            <option value="@cat.Id" selected="selected">@cat.Name</option>
                        }
                        else
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <select name="statusFilter" class="form-select">
                <option value="">Все статусы</option>
                <!option value="available" @(ViewBag.CurrentStatus == "available" ? "selected" : "")>В наличии</!option>
                <!option value="borrowed" @(ViewBag.CurrentStatus == "borrowed" ? "selected" : "")>Выданы</!option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="sortOrder" class="form-select">
                <option value="">Сортировка (новые)</option>
                <!option value="title_desc" @(ViewBag.CurrentSort == "title_desc" ? "selected" : "")>Название (Z-A)</!option>
                <!option value="author" @(ViewBag.CurrentSort == "author" ? "selected" : "")>Автор (A-Z)</!option>
                <!option value="status" @(ViewBag.CurrentSort == "status" ? "selected" : "")>По статусу</!option>
            </select>
        </div>

        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Применить</button>
            <a asp-action="Index" class="btn btn-secondary">Сбросить</a>
        </div>
    </form>

    <!-- Карточки книг -->
    @if (!Model.Any())
    {
        <div class="alert alert-warning">Книги не найдены.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var book in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm text-center p-3">
                        <img src="@(string.IsNullOrEmpty(book.CoverImagePath) ? "https://via.placeholder.com/150x200?text=No+Cover" : book.CoverImagePath)" 
                             class="card-img-top mx-auto" style="max-height: 200px; object-fit: contain;" alt="Обложка">
                        
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@book.Title</h5>
                            <p class="card-text text-muted mb-1">Автор: @book.Author</p>
                            <p class="card-text text-muted mb-1"><small>Категория: @(book.Category?.Name ?? "Нет")</small></p>
                            <p class="card-text mb-3">
                                Статус: 
                                <span class="badge @(book.IsAvailable ? "bg-success" : "bg-danger")">
                                    @(book.IsAvailable ? "В наличии" : "Выдана")
                                </span>
                            </p>

                            <div class="mt-auto d-flex justify-content-between">
                                @if (book.IsAvailable)
                                {
                                    <a asp-action="Take" asp-route-id="@book.Id" class="btn btn-sm btn-primary">Получить</a>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary" disabled>Получить</button>
                                }
                                <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary">Подробнее</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    
    <div class="d-flex justify-content-between mt-4">
        @if (currentPage > 1)
        {
            <a class="btn btn-outline-primary" asp-action="Index" 
               asp-route-page="@(currentPage - 1)" 
               asp-route-searchString="@ViewBag.CurrentSearch"
               asp-route-statusFilter="@ViewBag.CurrentStatus"
               asp-route-categoryId="@ViewBag.CurrentCategory"
               asp-route-sortOrder="@ViewBag.CurrentSort">Предыдущая</a>
        }
        else
        {
            <button class="btn btn-outline-secondary disabled">Предыдущая</button>
        }

        <span>Страница @currentPage из @(totalPages == 0 ? 1 : totalPages)</span>

        @if (currentPage < totalPages)
        {
            <a class="btn btn-outline-primary" asp-action="Index" 
               asp-route-page="@(currentPage + 1)"
               asp-route-searchString="@ViewBag.CurrentSearch"
               asp-route-statusFilter="@ViewBag.CurrentStatus"
               asp-route-categoryId="@ViewBag.CurrentCategory"
               asp-route-sortOrder="@ViewBag.CurrentSort">Следующая</a>
        }
        else
        {
            <button class="btn btn-outline-secondary disabled">Следующая</button>
        }
    </div>
</div>