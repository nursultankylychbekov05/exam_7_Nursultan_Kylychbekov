@model LibraryApp.Models.Book

@{
    ViewData["Title"] = "Получение книги";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>Личный кабинет</h2>
    <hr />

    <div class="card p-4 shadow-sm">
        <div class="row">
            <div class="col-md-4 text-center">
                <img src="@(string.IsNullOrEmpty(Model.CoverImagePath) ? "https://via.placeholder.com/150x200?text=No+Cover" : Model.CoverImagePath)" 
                     class="img-fluid rounded" style="max-height: 200px;" alt="Обложка">
            </div>
            <div class="col-md-8">
                <p>Вы берете книгу <strong>@Model.Title</strong></p>
                <p>Автор: <strong>@Model.Author</strong></p>
                <p>Статус: <span class="badge bg-success">В наличии</span></p>

                <form asp-action="Take" method="post" class="mt-3">
                    <input type="hidden" name="id" value="@Model.Id" />
                    
                    <div class="mb-3">
                        <label for="email" class="form-label">Введите email для получения книги:</label>
                        <input type="email" id="email" name="email" class="form-control" required placeholder="user@example.com" />
                    </div>

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <button type="submit" class="btn btn-primary">Получить</button>
                    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
                </form>
            </div>
        </div>
    </div>
</div>